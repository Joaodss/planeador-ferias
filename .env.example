# Copia para .env e preenche. O .env nunca vai para o GitHub (está no .gitignore).
PLANNER_USER=beatriz
# Mínimo 10 caracteres. Para gerar uma: openssl rand -base64 24
PLANNER_PASSWORD=
# Opcional: segundo fuso mostrado na grelha ao lado da hora da viagem (ex.: Europe/Lisbon).
# Sem isto usa o fuso do browser. Cada dispositivo pode escolher outro em "Datas e sítios".
PLANNER_HOME_TZ=
